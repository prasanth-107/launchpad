# ==============================================================================
# MODERN PLACEMENT LAUNCHPAD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or configure in your deployment platform (Vercel, Cloud Run, Render, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (Vite / React)
# ------------------------------------------------------------------------------
# Live Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous API Key (safe for client-side use with RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Backend FastAPI Gateway URL (defaults to http://localhost:8000 if omitted)
VITE_API_BASE=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT (FastAPI / Python)
# ------------------------------------------------------------------------------
# Environment mode: development | production | test
ENVIRONMENT=production

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Google Gemini AI API Key (Optional: platform falls back to deterministic engine if absent)
GEMINI_API_KEY=your-gemini-api-key-here

# YouTube Data API Key (Optional: for supplemental placement video tutorials)
YOUTUBE_API_KEY=your-youtube-api-key-here

# JWT Secret Key for Session Authentication
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-chars
